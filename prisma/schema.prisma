generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Meal {
  LUNCH
  DINNER
}

enum ReservationStatus {
  ACTIVE
  CANCELED
}

enum TransactionType {
  TOPUP
  RESERVE
  REFUND
}

enum TransactionStatus {
  SUCCESS
  PENDING
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            String   @id @default(cuid())
  studentNumber String   @unique
  firstName     String
  lastName      String
  phone         String
  passwordHash  String
  role          Role     @default(STUDENT)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  wallet       Wallet?
  reservations Reservation[]
  transactions Transaction[]
  payments     Payment[]
}

// موجودی به تومان و به‌صورت عدد صحیح نگهداری می‌شود
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Food {
  id          String         @id @default(cuid())
  name        String
  category    String
  description String?
  ingredients String?
  imageUrl    String?
  price       Int
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  schedules   FoodSchedule[]
}

model FoodSchedule {
  id              String   @id @default(cuid())
  foodId          String
  date            DateTime // نیمه‌شب UTC روز موردنظر
  meal            Meal
  capacity        Int
  reservedCount   Int      @default(0)
  price           Int
  reserveDeadline DateTime
  isActive        Boolean  @default(true)
  food            Food     @relation(fields: [foodId], references: [id])
  reservations    Reservation[]

  @@unique([foodId, date, meal])
  @@index([date, meal])
}

model Reservation {
  id         String            @id @default(cuid())
  userId     String
  scheduleId String
  status     ReservationStatus @default(ACTIVE)
  price      Int
  createdAt  DateTime          @default(now())
  canceledAt DateTime?
  user       User              @relation(fields: [userId], references: [id])
  schedule   FoodSchedule      @relation(fields: [scheduleId], references: [id])
  transactions Transaction[]

  @@unique([userId, scheduleId])
  @@index([userId, status])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amount      Int
  authority   String        @unique
  status      PaymentStatus @default(PENDING)
  refId       String?
  createdAt   DateTime      @default(now())
  verifiedAt  DateTime?
  user        User          @relation(fields: [userId], references: [id])
  transaction Transaction?
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Int
  status        TransactionStatus @default(SUCCESS)
  balanceAfter  Int
  description   String
  reservationId String?
  paymentId     String?           @unique // یک پرداخت فقط یک‌بار تراکنش می‌سازد
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id])
  reservation   Reservation?      @relation(fields: [reservationId], references: [id])
  payment       Payment?          @relation(fields: [paymentId], references: [id])

  @@index([userId, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}
